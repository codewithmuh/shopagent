# ShopAgent — environment configuration
# Copy this file to `.env` (`cp .env.example .env`) and fill in the values.
# The hostnames below (db, redis) are the Docker Compose service names, so the
# defaults work out-of-the-box with `make up`.

# ─────────────────────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# Database (Postgres)
# ─────────────────────────────────────────────────────────────
DB_NAME=shopagent
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# Redis (Channels layer for WebSocket chat)
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────
# CORS / CSRF — comma-separated origins allowed to call the API
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Anthropic — REQUIRED. Powers the AI shopping agent (Leo).
# Get a key at https://console.anthropic.com/
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─────────────────────────────────────────────────────────────
# Display currency — merchant prices are normalized to this for shoppers.
# Supported: USD, GBP, EUR, AED, SAR, PKR, INR, JPY, CNY, AUD, CAD
# ─────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=USD

# ─────────────────────────────────────────────────────────────
# OpenAI — OPTIONAL. Only needed for voice mode (text-to-speech).
# Leave blank to run text-only; voice replies are disabled without it.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# AWS S3 — OPTIONAL. Re-hosts synced product images on your own S3 bucket.
# Leave blank to keep the original Shopify CDN image URLs (fine for local/demo).
# ─────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=shopagent-product-images
AWS_S3_REGION=us-east-1

# ─────────────────────────────────────────────────────────────
# Shopify — NO global key needed here. Each merchant connects their own
# store from the Merchant Portal (Connections → shop domain + Admin API
# access token). See docs/SHOPIFY_SETUP.md for the dev-store walkthrough.
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# Next.js (frontend) — public URLs of the backend, baked into the client.
# Use ws:// for local, wss:// behind TLS in production.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ─────────────────────────────────────────────────────────────
# Demo company (shopper demo at /demo) — OPTIONAL.
# These default to the seeded Acme demo company; only set them to point the
# demo storefront at a different API-consumer company you've created.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_CLIENT_ID=shopagent_test_demo
NEXT_PUBLIC_DEMO_SECRET_KEY=sk_test_demo_secret_key_for_local_development_only
