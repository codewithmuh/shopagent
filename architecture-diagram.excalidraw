    {
      "id": "agent-box-text",
      "type": "text",
      "x": 90,
      "y": 905,
      "width": 440,
      "height": 120,
      "text": "AI Agent Engine (agent.py + tools.py + memory.py)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nchat() loop: Claude Sonnet → tool_use → execute → respond\n\n8 Tools: search_products | get_product_details | register_user\nget_user_info | check_wallet_balance | create_order\nget_order_status | get_user_orders",
      "fontSize": 13,
      "fontFamily": 1,
